# The vault worker's address. Defaults to the local wrangler dev server when
# unset, so `pnpm worker:dev` and `pnpm web:dev` work together untouched.
VITE_VAULT_URL=http://127.0.0.1:8787

# Cloudflare Turnstile's PUBLIC site key. Leave unset and publishing sends no token. The matching secret
# is a Worker secret (TURNSTILE_SECRET), never a variable here. See src/lib/turnstile.ts.
# VITE_TURNSTILE_SITEKEY=
