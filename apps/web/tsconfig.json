{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "rootDir": ".",
    "outDir": "dist",
    "types": [
      "vite/client"
    ],
    "paths": {
      "@bertinis-vault/contracts": [
        "../../packages/contracts/dist/index.d.ts"
      ],
      "@bertinis-vault/data-engine": [
        "../../packages/data-engine/dist/index.d.ts"
      ],
      "@bertinis-vault/domain": [
        "../../packages/domain/dist/index.d.ts"
      ],
      "@bertinis-vault/foundry-exporter": [
        "../../packages/foundry-exporter/dist/index.d.ts"
      ],
      "@bertinis-vault/vetools-index": [
        "../../packages/vetools-index/dist/index.d.ts"
      ],
      "@bertinis-vault/vetools-ref": [
        "../../packages/vetools-ref/dist/index.d.ts"
      ],
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "probes/**/*.ts",
    "*.config.ts"
  ],
  "exclude": [
    "test/pending"
  ]
}