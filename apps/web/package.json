{
  "name": "@bertinis-vault/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node ../../scripts/build-ogl-sheet.mjs",
    "prebuild": "node ../../scripts/build-ogl-sheet.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "node ../../scripts/build-ogl-sheet.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "probe": "vite build --ssr probes/conformance.ts --outDir .probe --logLevel error && node .probe/conformance.js"
  },
  "dependencies": {
    "@bertinis-vault/contracts": "workspace:*",
    "@bertinis-vault/data-engine": "workspace:*",
    "@bertinis-vault/domain": "workspace:*",
    "@bertinis-vault/foundry-exporter": "workspace:*",
    "@bertinis-vault/vetools-index": "workspace:*",
    "@bertinis-vault/vetools-ref": "workspace:*",
    "framer-motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "zod": "^3.24.2",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.3.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.19",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.8.2",
    "vite": "^6.2.4",
    "vitest": "^4.1.11"
  }
}
