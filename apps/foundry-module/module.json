{
  "id": "bertinis-vault",
  "title": "Bertini's Vault — Character Import",
  "description": "Import a character built at Bertini's Vault using a short code. Resolves every spell, item and feature through Plutonium, so they arrive as real dnd5e documents.",
  "version": "0.2.2",
  "authors": [{ "name": "Bertini's Vault" }],
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "relationships": {
    "systems": [
      {
        "id": "dnd5e",
        "type": "system",
        "compatibility": { "minimum": "5.3.0", "verified": "5.3.3" }
      }
    ],
    "requires": [
      {
        "id": "plutonium",
        "type": "module",
        "reason": "Plutonium resolves every 5etools reference into a real dnd5e document. Without it there is nothing to import."
      }
    ]
  },
  "esmodules": ["src/module.js"],
  "styles": ["styles/vault.css"],
  "languages": [
    { "lang": "en", "name": "English", "path": "lang/en.json" },
    { "lang": "es", "name": "Español", "path": "lang/es.json" }
  ],
  "url": "https://github.com/Joabertini/bertinis-vault",
  "manifest": "https://raw.githubusercontent.com/Joabertini/bertinis-vault/main/apps/foundry-module/module.json",
  "download": "https://github.com/Joabertini/bertinis-vault/releases/latest/download/bertinis-vault.zip"
}
